# ---------------------------------------------------------------------------
# .env.example — 环境变量模板
#
# 使用方法：
#   cp .env.example ~/.inn-stego.env
#   nano ~/.inn-stego.env        # 修改密码和 SECRET_KEY
#   chmod 600 ~/.inn-stego.env   # 只有本用户可读
# ---------------------------------------------------------------------------

# Flask Session 密钥 — 请替换为随机字符串，例如：
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为随机字符串

# 登录账号（请修改默认密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请替换为强密码

# 监听端口（默认 5000）
PORT=5000

# SQLite 数据库文件路径（默认 ~/.inn-stego-data.db，无需额外安装数据库）
# SQLITE_DB_PATH=/path/to/inn-stego.db

# 可选高级参数
# WORKERS=1
# TIMEOUT=180
# LOG_LEVEL=info
