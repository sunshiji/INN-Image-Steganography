# ---------------------------------------------------------------------------
# inn-stego.service - systemd user service
#
# Uses %h (home directory) for portability.
# Credentials loaded from EnvironmentFile (~/.inn-stego.env).
#
# Install:
#   cp .env.example ~/.inn-stego.env
#   nano ~/.inn-stego.env          # set SECRET_KEY and ADMIN_PASSWORD
#   chmod 600 ~/.inn-stego.env
#
#   mkdir -p ~/.config/systemd/user
#   cp inn-stego.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable inn-stego
#   systemctl --user start  inn-stego
#   sudo loginctl enable-linger $USER   # survive SSH logout, run once as root
#
#   systemctl --user status inn-stego
#   journalctl --user -u inn-stego -f
# ---------------------------------------------------------------------------

[Unit]
Description=INN Image Steganography System
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/sys/INN-Image-Steganography/backend

# Load credentials (SECRET_KEY, ADMIN_PASSWORD, PORT, etc.)
EnvironmentFile=-%h/.inn-stego.env

# --- Conda env option (recommended if using conda pris) ---
# Uncomment and set the correct conda env bin path:
# Environment=CONDA_PREFIX=/home/sunshiji/anaconda3/envs/pris
# ExecStart=/home/sunshiji/anaconda3/envs/pris/bin/gunicorn \
#     --config %h/sys/INN-Image-Steganography/backend/gunicorn.conf.py \
#     app:app

# --- Venv option (default) ---
# Use start.sh which auto-detects venv, CONDA_PREFIX, or system gunicorn
ExecStart=/bin/bash %h/sys/INN-Image-Steganography/start.sh

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=inn-stego

[Install]
WantedBy=default.target
