# ---------------------------------------------------------------------------
# .gitattributes
#
# Enforce Unix LF line endings for all text files so shell scripts work
# correctly on Linux servers regardless of the client OS (Windows/macOS).
# ---------------------------------------------------------------------------

# Default: auto-detect text files and normalise to LF on checkout
* text=auto eol=lf

# Explicitly force LF for shell / config files
*.sh     text eol=lf
*.py     text eol=lf
*.cfg    text eol=lf
*.conf   text eol=lf
*.ini    text eol=lf
*.toml   text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.service text eol=lf
.env*    text eol=lf

# Binary files — never touch line endings
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.whl    binary
*.zip    binary
*.tar.gz binary
*.pt     binary
*.pth    binary
