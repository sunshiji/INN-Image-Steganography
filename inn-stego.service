# ---------------------------------------------------------------------------
# inn-stego.service - systemd user service
#
# Uses %h (home directory) for portability across user accounts.
# Credentials loaded from EnvironmentFile (~/.inn-stego.env).
#
# Install:
#   cp .env.example ~/.inn-stego.env
#   nano ~/.inn-stego.env          # set SECRET_KEY and ADMIN_PASSWORD
#   chmod 600 ~/.inn-stego.env
#
#   mkdir -p ~/.config/systemd/user
#   cp inn-stego.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable inn-stego
#   systemctl --user start  inn-stego
#
#   # Keep service running after SSH logout (run once as root):
#   sudo loginctl enable-linger $USER
#
#   # View status / logs:
#   systemctl --user status inn-stego
#   journalctl --user -u inn-stego -f
# ---------------------------------------------------------------------------

[Unit]
Description=INN Image Steganography System
After=network.target

[Service]
Type=simple
# %h expands to the user's home directory (e.g. /home/sunshiji)
WorkingDirectory=%h/sys/INN-Image-Steganography/backend

# Load credentials from a separate file (not stored in the service unit)
# The leading '-' means: ignore silently if file is absent
EnvironmentFile=-%h/.inn-stego.env

# Use the project venv's gunicorn; change to conda gunicorn path if preferred
ExecStart=%h/sys/INN-Image-Steganography/venv/bin/gunicorn \
    --config %h/sys/INN-Image-Steganography/backend/gunicorn.conf.py \
    app:app

Restart=on-failure
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=inn-stego

[Install]
WantedBy=default.target
